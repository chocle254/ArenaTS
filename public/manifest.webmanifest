    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tournaments", "url": "/tournaments", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
